# Copy to .env to override defaults. Shell environment variables take precedence.
ITOR_WEB_ORIGIN=http://127.0.0.1:3000
ITOR_AGENT_URL=http://127.0.0.1:8765
# The launcher creates a fresh key for both processes unless a key is provided.
# ITOR_AGENT_KEY=
ITOR_DB_PATH=.itor/local.sqlite3
ITOR_RETENTION_DAYS=7
ITOR_OLLAMA_URL=http://127.0.0.1:11434
ITOR_OLLAMA_MODEL=qwen3.5:4b
# Enable HTTPS/DNS checks only with an organization-approved endpoint.
# ITOR_INTERNET_PROBE_URL=https://approved.example.test/generate_204
ITOR_INTERNET_EXPECTED_STATUS=204
ITOR_CONNECTIVITY_INTERVAL_SECONDS=30
ITOR_CONNECTIVITY_TIMEOUT_SECONDS=3
ITOR_CONNECTIVITY_STABILITY_SECONDS=5
ITOR_CPU_WARNING_PERCENT=80
ITOR_CPU_WINDOW_SECONDS=6
ITOR_DEMO_WORKLOAD_SECONDS=180
ITOR_OLLAMA_TIMEOUT_SECONDS=60
ITOR_TELEMETRY_INTERVAL_SECONDS=2
# Name shown to your manager (default: your Windows user name).
# ITOR_EMPLOYEE_NAME=
# No mouse or keyboard for this long = idle.
ITOR_IDLE_SECONDS=120
# Company server that receives daily time and outage logs (never Nexthink).
# Empty = this PC plays the company server for the demo.
# ITOR_COMPANY_URL=https://itor.your-company.example
# ITOR_COMPANY_KEY=
# Show 4 example colleagues on the Team page (1 = yes, 0 = no).
ITOR_DEMO_TEAM=1
# Claude is used when internet works. The key is read from ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=
ITOR_CLAUDE_MODEL=claude-opus-5-5
