# Copy to .env to override defaults. Shell environment variables take precedence.
SPARK_WEB_ORIGIN=http://127.0.0.1:3000
SPARK_AGENT_URL=http://127.0.0.1:8765
# The launcher creates a fresh key for both processes unless a key is provided.
# SPARK_AGENT_KEY=
SPARK_DB_PATH=.spark-ready/local.sqlite3
SPARK_RETENTION_DAYS=7
SPARK_OLLAMA_URL=http://127.0.0.1:11434
SPARK_OLLAMA_MODEL=qwen3.5:4b
# Enable HTTPS/DNS checks only with an organization-approved endpoint.
# SPARK_INTERNET_PROBE_URL=https://approved.example.test/generate_204
SPARK_INTERNET_EXPECTED_STATUS=204
SPARK_CONNECTIVITY_INTERVAL_SECONDS=30
SPARK_CONNECTIVITY_TIMEOUT_SECONDS=3
SPARK_CONNECTIVITY_STABILITY_SECONDS=5
SPARK_CPU_WARNING_PERCENT=80
SPARK_CPU_WINDOW_SECONDS=6
SPARK_DEMO_WORKLOAD_SECONDS=180
SPARK_OLLAMA_TIMEOUT_SECONDS=60
SPARK_TELEMETRY_INTERVAL_SECONDS=2
